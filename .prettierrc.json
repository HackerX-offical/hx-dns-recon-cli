{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "proseWrap": "always",
  "overrides": [
    {
      "files": ["*.md", "ARCHITECTURE.md", "SECURITY.md"],
      "options": {
        "proseWrap": "always",
        "printWidth": 88
      }
    }
  ]
}
