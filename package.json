{
  "name": "hx-dns-recon-cli",
  "version": "1.0.0",
  "description": "DNS reconnaissance CLI for authorized security assessments",
  "type": "module",
  "bin": {
    "hx-dns": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["dns", "recon", "osint", "subdomain", "cli", "hackerx"],
  "author": "HackerX Official",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
