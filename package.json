{
  "name": "hx-dns-recon-cli",
  "version": "1.0.0",
  "description": "DNS reconnaissance CLI for authorized security assessments",
  "type": "module",
  "bin": {
    "hx-dns": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js",
    "prepublishOnly": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "dns",
    "recon",
    "osint",
    "subdomain",
    "cli",
    "hackerx"
  ],
  "author": "HackerX Official",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HackerX-official/hx-dns-recon-cli.git"
  },
  "homepage": "https://github.com/HackerX-official/hx-dns-recon-cli#readme",
  "bugs": {
    "url": "https://github.com/HackerX-official/hx-dns-recon-cli/issues"
  }
}
